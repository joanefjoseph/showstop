SENDER_NAME=Jane Doe
SENDER_EMAIL=jane@thenewcompany.com
EMAIL_PASSWORD="your-mailbox-password"
COMPANY_NAME=The New Company
COMPANY_URL=www.thenewcompany.com

# Which data source to use by default: csv or sqlite
DATA_SOURCE=sqlite
# Only needed if your DB isn't named "<COMPANY_NAME>.db" in the current folder
# DB_PATH=C:\path\to\The New Company.db

MAILSFINDER_API_KEY="your-api-key"
MAILSFINDER_DAILY_LIMIT=100
# Optional:
# MAILSFINDER_STRATEGY=find          # find (default) or verify
# MAILSFINDER_MIN_CONFIDENCE=0       # ignore Find results below this confidence (0-100)