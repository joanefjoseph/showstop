# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Your name exactly as LinkedIn shows it (comma-separate aliases if needed)
LINKEDIN_MY_NAME=Jane Founder

# Schedule (24h, local time unless TIMEZONE is set, e.g. America/New_York)
RUN_TIMES=09:00,13:00,17:00
TIMEZONE=

# Scanning behaviour
MAX_THREADS_PER_RUN=15
MAX_MESSAGES_PER_THREAD=30
HEADLESS=false
# Optional: "chrome" to use your installed Google Chrome instead of bundled Chromium
BROWSER_CHANNEL=

# Sending: set to false to only allow Copy & Open (no automated posting at all)
ENABLE_DIRECT_SEND=true

# Optional booking link the assistant may offer when proposing meetings
MEETING_LINK=

# UI
HOST=127.0.0.1
PORT=5055
OPEN_BROWSER_ON_NEW_DRAFTS=true

# Free-tier friendly pacing between Gemini calls
LLM_MIN_INTERVAL_SECONDS=7

# Connection-note follow-ups
# How many threads from the top of the inbox to consider each run
CONVERSATION_SCAN_DEPTH=40
# Max "You:" threads to open per run to check whether they're accepted connection notes
MAX_FOLLOWUP_CHECKS_PER_RUN=10
# A single message from you at or under this length counts as a connection note (LinkedIn max is 300)
CONNECTION_NOTE_MAX_CHARS=300
# Only follow up on connections accepted within this many days (0 = no limit)
FOLLOWUP_MAX_AGE_DAYS=14