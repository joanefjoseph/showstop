# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional backups, tried in order if the main model is retired or unavailable to your key
GEMINI_FALLBACK_MODELS=
# Optional; leave empty to use the model's default
GEMINI_TEMPERATURE=

# Your name exactly as LinkedIn shows it (comma-separate aliases if needed)
LINKEDIN_MY_NAME=Jane Founder

# Schedule (24h, local time unless TIMEZONE is set, e.g. America/New_York)
RUN_TIMES=09:00,13:00,17:00
TIMEZONE=

# Scanning behaviour
MAX_THREADS_PER_RUN=15
MAX_MESSAGES_PER_THREAD=30
HEADLESS=false
# Optional: "chrome" to use your installed Google Chrome instead of bundled Chromium
BROWSER_CHANNEL=

# Sending: set to false to only allow Copy & Open (no automated posting at all)
ENABLE_DIRECT_SEND=true

# Optional booking link the assistant may offer when proposing meetings
MEETING_LINK=

# UI
HOST=127.0.0.1
PORT=5055
OPEN_BROWSER_ON_NEW_DRAFTS=true

# Free-tier friendly pacing between Gemini calls
LLM_MIN_INTERVAL_SECONDS=7

# Connection-note follow-ups
# How many threads from the top of the inbox to consider each run
CONVERSATION_SCAN_DEPTH=40
# Max "You:" threads to open per run to check whether they're accepted connection notes
MAX_FOLLOWUP_CHECKS_PER_RUN=10
# A single message from you at or under this length counts as a connection note (LinkedIn max is 300)
CONNECTION_NOTE_MAX_CHARS=300
# Only follow up on connections accepted within this many days (0 = no limit)
FOLLOWUP_MAX_AGE_DAYS=14

# ---------------- Work email (Namecheap Private Email) ----------------
EMAIL_ADDRESS=you@yourdomain.com
EMAIL_PASSWORD=
# Name shown in the From header (defaults to LINKEDIN_MY_NAME)
EMAIL_DISPLAY_NAME=
# Other addresses that are also you (comma-separated), e.g. aliases
EMAIL_ALIASES=

EMAIL_IMAP_HOST=mail.privateemail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_HOST=mail.privateemail.com
# 465 = SSL/TLS, 587 = STARTTLS
EMAIL_SMTP_PORT=465
# Leave empty to auto-detect the Sent folder (falls back to "Sent")
EMAIL_SENT_FOLDER=

# Only consider unanswered inbox emails from the last N days, max M new emails per run
EMAIL_LOOKBACK_DAYS=3
EMAIL_MAX_PER_RUN=20
EMAIL_BODY_MAX_CHARS=6000

# Quote the original email under your reply (standard email behaviour)
EMAIL_QUOTE_ORIGINAL=true
# Optional signature appended to every drafted reply; use \n for line breaks
EMAIL_SIGNATURE=
EMAIL_WEBMAIL_URL=https://privateemail.com/appsuite/

# Set to false to run email-only
LINKEDIN_ENABLED=true